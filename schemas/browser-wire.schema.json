{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locushost.co/schemas/browser-wire-v1.json",
  "title": "Locus Browser Broker Protocol",
  "oneOf": [
    { "$ref": "#/$defs/setBrowserControl" },
    { "$ref": "#/$defs/browserActionRequest" },
    { "$ref": "#/$defs/browserActionResult" },
    { "$ref": "#/$defs/setWalletControl" },
    { "$ref": "#/$defs/walletActionRequest" },
    { "$ref": "#/$defs/walletActionResult" },
    { "$ref": "#/$defs/agentUserMessage" },
    { "$ref": "#/$defs/researchBoardRequest" },
    { "$ref": "#/$defs/researchBoardProgress" },
    { "$ref": "#/$defs/researchBoardResult" },
    { "$ref": "#/$defs/researchBoardError" }
  ],
  "$defs": {
    "setBrowserControl": {
      "type": "object",
      "required": ["type", "enabled"],
      "properties": {
        "type": { "const": "set_browser_control" },
        "enabled": { "type": "boolean" },
        "history_enabled": { "type": "boolean" },
        "autofill_categories": {
          "type": "array",
          "items": { "enum": ["password", "contact", "paymentCard"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "browserActionRequest": {
      "type": "object",
      "required": ["type", "request_id", "tool", "arguments", "timeout_ms", "session_id"],
      "properties": {
        "type": { "const": "browser_action_request" },
        "request_id": { "type": "string", "minLength": 1 },
        "tool": {
          "enum": [
            "browser_history",
            "browser_autofill",
            "browser_read_page", "browser_get_text", "browser_find",
            "browser_navigate", "browser_tabs", "browser_input",
            "browser_screenshot", "browser_wait_for", "browser_console",
            "browser_network", "browser_resize", "browser_javascript",
            "browser_dev_server"
          ]
        },
        "arguments": { "type": "object" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 180000 },
        "session_id": { "type": "string", "minLength": 1 },
        "access": {
          "type": "object",
          "properties": {
            "tab_id": { "type": "string" },
            "level": { "enum": ["read", "interact"] },
            "source": { "enum": ["user_share", "agent_created"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "browserActionResult": {
      "type": "object",
      "required": ["type", "request_id", "result"],
      "properties": {
        "type": { "const": "browser_action_result" },
        "request_id": { "type": "string", "minLength": 1 },
        "result": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "error": { "type": "string" }
          },
          "anyOf": [
            { "required": ["text"] },
            { "required": ["error"] }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "setWalletControl": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "set_wallet_control" },
        "capability": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "protocol_version", "signer_state", "session_id",
                "supported_chains", "allowed_operations"
              ],
              "properties": {
                "protocol_version": { "const": 1 },
                "signer_state": { "const": "unlocked" },
                "session_id": { "type": "string", "minLength": 1 },
                "supported_chains": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[^:]+:.+$" }
                },
                "allowed_operations": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {
                    "enum": [
                      "wallet_list_accounts", "wallet_get_balance", "wallet_get_activity",
                      "wallet_prepare_transaction", "wallet_simulate_transaction",
                      "wallet_execute_transaction", "wallet_lock"
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "enabled": {
          "type": "boolean",
          "deprecated": true,
          "description": "Legacy fail-closed field. It can revoke wallet access but never enables tools without capability."
        }
      },
      "additionalProperties": false
    },
    "walletActionRequest": {
      "type": "object",
      "required": ["type", "request_id", "tool", "arguments", "timeout_ms", "session_id"],
      "properties": {
        "type": { "const": "wallet_action_request" },
        "request_id": { "type": "string", "minLength": 1 },
        "tool": {
          "enum": [
            "wallet_list_accounts", "wallet_get_balance", "wallet_get_activity",
            "wallet_prepare_transaction", "wallet_simulate_transaction",
            "wallet_execute_transaction", "wallet_lock"
          ]
        },
        "arguments": { "type": "object" },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "session_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "walletActionResult": {
      "type": "object",
      "required": ["type", "request_id", "result"],
      "properties": {
        "type": { "const": "wallet_action_result" },
        "request_id": { "type": "string", "minLength": 1 },
        "result": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "error": { "type": "string" }
          },
          "anyOf": [
            { "required": ["text"] },
            { "required": ["error"] }
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "recordingTranscriptSegment": {
      "type": "object",
      "required": ["source", "start_ms", "end_ms", "text"],
      "properties": {
        "source": { "enum": ["tab", "microphone"] },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "tab_id": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "speechSettings": {
      "type": "object",
      "required": ["engine", "language", "local_model_status"],
      "properties": {
        "engine": { "enum": ["local", "openai", "custom"] },
        "language": { "type": "string", "minLength": 2, "maxLength": 16 },
        "custom_base_url": { "type": "string", "maxLength": 2048 },
        "custom_model": { "type": "string", "maxLength": 255 },
        "local_model_status": { "enum": ["missing", "downloading", "ready", "error"] },
        "local_model_progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "message": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "recordingSourceState": {
      "type": "object",
      "required": ["tab_audio", "microphone"],
      "properties": {
        "tab_audio": { "type": "boolean" },
        "microphone": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "transcriptSegment": {
      "type": "object",
      "required": ["id", "recording_id", "source", "start_ms", "end_ms", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "recording_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source": { "enum": ["tab", "microphone"] },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "tab_id": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "recordingTranscriptSummary": {
      "type": "object",
      "required": ["id", "work_session_id", "started_at", "duration_ms", "segment_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "work_session_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "started_at": { "type": "integer", "minimum": 0 },
        "ended_at": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "segment_count": { "type": "integer", "minimum": 0 },
        "video_path": { "type": "string", "maxLength": 8192 }
      },
      "additionalProperties": false
    },
    "recordingSessionState": {
      "type": "object",
      "required": ["status", "elapsed_ms", "sources", "save_video", "transcript_preview", "transcripts", "engine"],
      "properties": {
        "status": { "enum": ["idle", "starting", "recording", "paused", "stopping", "error"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "started_at": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "sources": { "$ref": "#/$defs/recordingSourceState" },
        "save_video": { "type": "boolean" },
        "active_tab_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "paused_reason": { "type": "string", "maxLength": 512 },
        "transcript_preview": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/transcriptSegment" } },
        "transcripts": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/recordingTranscriptSummary" } },
        "engine": { "enum": ["local", "openai", "custom"] },
        "error": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "browserObservationFrame": {
      "type": "object",
      "required": ["captured_at", "mime_type", "data", "description"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "mime_type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "data": { "type": "string", "minLength": 1, "maxLength": 12000000 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "browserObservationContext": {
      "type": "object",
      "required": ["recording_id", "captured_at"],
      "properties": {
        "recording_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "captured_at": { "type": "string", "format": "date-time" },
        "active_tab": {
          "type": "object",
          "required": ["id", "title", "url", "access_level"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "title": { "type": "string", "maxLength": 2048 },
            "url": { "type": "string", "maxLength": 8192 },
            "access_level": { "enum": ["read", "interact"] }
          },
          "additionalProperties": false
        },
        "transcript": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/recordingTranscriptSegment" } },
        "page_text": { "type": "string", "maxLength": 12000 },
        "frames": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/browserObservationFrame" } },
        "paused_reason": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "agentUserMessage": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "user_message" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "mode": { "enum": ["ask", "work", "plan", "build"] },
        "browser_context": { "$ref": "#/$defs/browserObservationContext" },
        "portable_memory": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/portableMemoryRecord" }
        }
      },
      "additionalProperties": true
    },
    "portableMemoryRecord": {
      "type": "object",
      "required": ["blob_id", "text"],
      "properties": {
        "blob_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "title": { "type": "string", "maxLength": 2048 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 8192 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "researchPassage": {
      "type": "object",
      "required": ["passage_id", "text"],
      "properties": {
        "passage_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 }
      },
      "additionalProperties": false
    },
    "researchSource": {
      "type": "object",
      "required": ["source_id", "tab_id", "title", "url", "captured_at", "content_hash", "passages"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "tab_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "title": { "type": "string", "maxLength": 2048 },
        "url": { "type": "string", "format": "uri", "maxLength": 8192 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "passages": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "$ref": "#/$defs/researchPassage" } }
      },
      "additionalProperties": false
    },
    "researchCitation": {
      "type": "object",
      "required": ["source_id", "passage_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "passage_id": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "researchClaim": {
      "type": "object",
      "required": ["text", "citations"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "citations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/researchCitation" } }
      },
      "additionalProperties": false
    },
    "researchSection": {
      "type": "object",
      "required": ["heading", "claims"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 500 },
        "claims": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/researchClaim" } }
      },
      "additionalProperties": false
    },
    "researchArtifact": {
      "type": "object",
      "required": ["title", "summary", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "sections": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/researchSection" } }
      },
      "additionalProperties": false
    },
    "researchBoardRequest": {
      "type": "object",
      "required": ["type", "request_id", "prompt", "format", "sources"],
      "properties": {
        "type": { "const": "research_board_request" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "format": { "enum": ["comparison", "brief", "evidence"] },
        "sources": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/researchSource" } }
      },
      "additionalProperties": false
    },
    "researchBoardProgress": {
      "type": "object",
      "required": ["type", "request_id", "message"],
      "properties": {
        "type": { "const": "research_board_progress" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "researchBoardResult": {
      "type": "object",
      "required": ["type", "request_id", "artifact"],
      "properties": {
        "type": { "const": "research_board_result" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "artifact": { "$ref": "#/$defs/researchArtifact" }
      },
      "additionalProperties": false
    },
    "researchBoardError": {
      "type": "object",
      "required": ["type", "request_id", "error"],
      "properties": {
        "type": { "const": "research_board_error" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "error": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "additionalProperties": false
    }
  }
}
